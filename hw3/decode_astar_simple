#!/usr/bin/env python3

import sys, optparse, heapq, models
from collections import namedtuple

optparser = optparse.OptionParser()
optparser.add_option("-i", "--input", dest="input", default="data/input")
optparser.add_option("-t", "--translation-model", dest="tm", default="data/tm")
optparser.add_option("-l", "--language-model", dest="lm", default="data/lm")
optparser.add_option("-n", "--num_sentences", dest="num_sents", default=sys.maxsize, type="int")
optparser.add_option("-k", "--translations_beamsearch-per-phrase", dest="k", default=1, type="int")
optparser.add_option("-m", "--max-hypotheses", dest="max_hypotheses", default=2000, type="int")
optparser.add_option("-r", "--reorder-limit", dest="reorder_limit", default=3, type="int")
optparser.add_option("-v", "--verbose", dest="verbose", action="store_true", default=False)
opts = optparser.parse_args()[0]

tm = models.TM(opts.tm, opts.k)
lm = models.LM(opts.lm)
french = [tuple(line.strip().split()) for line in open(opts.input).readlines()[:opts.num_sents]]

# Add unknown words
for word in set(sum(french,())):
    if (word,) not in tm:
        tm[(word,)] = [models.phrase(word, 0.0)]

class Node:
    def __init__(self, logprob, lm_state, covered, pred, phrase, words):
        self.logprob = logprob
        self.lm_state = lm_state
        self.covered = covered
        self.pred = pred
        self.phrase = phrase
        self.words = words
        self.f_score = logprob  # Simplified: no heuristic
    
    def __lt__(self, other):
        return self.f_score > other.f_score

def get_phrases(french, covered, limit=3):
    """Get available phrases with reordering limit"""
    f_len = len(french)
    phrases = []
    
    # Find uncovered segments
    segments = []
    start = None
    for i in range(f_len):
        if i not in covered:
            if start is None: start = i
        else:
            if start is not None:
                segments.append((start, i))
                start = None
    if start is not None:
        segments.append((start, f_len))
    
    # Get phrases in segments
    for seg_start, seg_end in segments:
        for i in range(seg_start, seg_end):
            for j in range(i + 1, min(i + limit + 1, seg_end + 1)):
                if j <= f_len:
                    phrase = french[i:j]
                    if phrase in tm:
                        phrases.append((i, j, phrase))
    
    return phrases

def score_phrase(translation, lm_state):
    logprob = translation.logprob
    new_lm_state = lm_state
    for word in translation.english.split():
        (new_lm_state, word_logprob) = lm.score(new_lm_state, word)
        logprob += word_logprob
    return logprob, new_lm_state

def astar_search(french):
    f_len = len(french)

    initial = Node(0.0, lm.begin(), set(), None, None, [])
    open_set = [initial]
    closed = set()
    nodes_expanded = 0
    
    while open_set and nodes_expanded < opts.max_hypotheses:
        current = heapq.heappop(open_set)
        nodes_expanded += 1
        
        if opts.verbose and nodes_expanded % 100 == 0:
            sys.stderr.write("Nodes: %d, Score: %.4f\n" % (nodes_expanded, current.f_score))
        
        # Check if complete
        if len(current.covered) == f_len:
            if opts.verbose:
                sys.stderr.write("Complete after %d nodes\n" % nodes_expanded)
            return current
        
        # Skip if processed
        state_key = (tuple(sorted(current.covered)), current.lm_state)
        if state_key in closed:
            continue
        closed.add(state_key)
        
        # Get available phrases
        phrases = get_phrases(french, current.covered, opts.reorder_limit)
        
        # Try each phrase
        for start, end, phrase in phrases:
            if phrase in tm:
                for translation in tm[phrase]:
                    # Score phrase
                    phrase_logprob, new_lm_state = score_phrase(translation, current.lm_state)
                    new_logprob = current.logprob + phrase_logprob
                    
                    # Add end probability if complete
                    new_covered = current.covered | set(range(start, end))
                    if len(new_covered) == f_len:
                        new_logprob += lm.end(new_lm_state)
                    
                    # Create new node
                    new_words = current.words + translation.english.split()
                    new_node = Node(new_logprob, new_lm_state, new_covered, 
                                  current, translation, new_words)
                    
                    heapq.heappush(open_set, new_node)
    
    # Return best node
    return max(open_set, key=lambda n: n.f_score) if open_set else initial

def complete_greedily(french, node): # Make sure all phrases are covered
    f_len = len(french)
    current = node
    
    while len(current.covered) < f_len:
        # Find first uncovered position
        uncovered = set(range(f_len)) - current.covered
        if not uncovered:
            break
        
        start = min(uncovered)
        best_phrase = None
        best_score = float('-inf')

        for end in range(start + 1, f_len + 1): # Try phrases starting from this position
            phrase = french[start:end]
            if phrase in tm:
                for translation in tm[phrase]:
                    score, _ = score_phrase(translation, current.lm_state)
                    if score > best_score:
                        best_score = score
                        best_phrase = (start, end, translation)
                break  # Only try first available phrase
        
        if best_phrase:
            start, end, translation = best_phrase
            phrase_logprob, new_lm_state = score_phrase(translation, current.lm_state)
            new_logprob = current.logprob + phrase_logprob
            new_covered = current.covered | set(range(start, end))
            
            if len(new_covered) == f_len:
                new_logprob += lm.end(new_lm_state)
            
            current = Node(new_logprob, new_lm_state, new_covered, 
                          current, translation, current.words + translation.english.split())
        else:
            break
    
    return current

sys.stderr.write("Decoding %s...\n" % (opts.input,))

for f in french:
    winner = astar_search(f)

    if len(winner.covered) < len(f):
        winner = complete_greedily(f, winner)

    if winner.words:
        print(" ".join(winner.words))
    else:
        print("*")
